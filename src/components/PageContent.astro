---
import type { AceEntry } from "@sandboxsonny/ace-kit";

import AceSections from "@sandboxsonny/ace-kit/astro/AceSections.astro";

import type { PageValues } from "../types/page";
import Hero from "./sections/Hero.astro";
import ImageWithText from "./sections/ImageWithText.astro";
import Steps from "./sections/Steps.astro";
import ContentSection from "./sections/ContentSection.astro";
import Contact from "./sections/Contact.astro";

type Props = {
  entry: AceEntry<PageValues>;
};

const { entry } = Astro.props;
const { content } = entry.values;
---

<AceSections
  sections={content}
  components={{
    hero: Hero,
    "image-with-text": ImageWithText,
    steps: Steps,
    "content-section": ContentSection,
    contact: Contact,
  }}
/>

<style>
  .prose {
    max-width: 42rem;
  }
  .intro {
    color: var(--colour-muted);
    font-size: 1.125rem;
  }
  .published {
    color: var(--colour-muted);
    font-size: 0.9rem;
  }
  .actions {
    margin-top: 2rem;
  }
  figure {
    margin: 2rem 0;
  }
  figure :global(img) {
    border-radius: 0.5rem;
  }
  .rich-text :global(* + *) {
    margin-top: 1rem;
  }
  .rich-text :global(h2) {
    font-size: 1.75rem;
  }
  .rich-text :global(h3) {
    font-size: 1.4rem;
  }
  .rich-text :global(h4) {
    font-size: 1.15rem;
  }
  .rich-text :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .rich-text :global(ol) {
    list-style: decimal;
    padding-left: 1.5rem;
  }
  .rich-text :global(blockquote) {
    border-left: 4px solid var(--colour-muted);
    padding-left: 1rem;
    font-style: italic;
  }
  .rich-text :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
